/* Message Actions Hover */
.buttonsInner_SY_P2T {
    overflow: hidden !important;
}
.buttonsInner_SY_P2T [aria-label]:not([aria-label="More"],[aria-label="Delete"]),
.buttonsInner_SY_P2T .separator_DpHsW6 {
    pointer-events: none;
    opacity: 0;
    position: relative;
    margin-left: -34px !important;
    transition: margin-left 0.3s ease, opacity 0.3s ease;
    z-index: 1;
}

.buttonsInner_SY_P2T:hover [aria-label]:not([aria-label="More"],[aria-label="Delete"]),
.buttonsInner_SY_P2T:hover .separator_DpHsW6 {
    pointer-events: all;
    opacity: 1;
    position: relative;
    margin-left: 0px !important;
}
