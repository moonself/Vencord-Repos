/* Chat Button Hover */
.buttons_2x8-Qn {
    gap: 0 !important;
    pointer-events: none;
&:hover {
    pointer-events: all;
  }
}
.expression-picker-chat-input-button {
    opacity: 0;
    pointer-events: none;
    transform: translateX(10px);
    transition: all 0.3s ease;
.buttons_2x8-Qn:hover & {
    opacity: 1;
    pointer-events: all;
    transform: none;
  }
&:has(.emojiButton_SjG8Ug) {
    opacity: 1 !important;
    pointer-events: all !important;
    transform: none !important;
  }
}
/* Hidden Buttons */
.app-launcher-entrypoint,[aria-label="Give a Gift"],[aria-label="Send a gift"] { 
    display: none;
}
